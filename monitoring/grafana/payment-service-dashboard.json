{
  "title": "payment-service — golden signals",
  "timezone": "utc",
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"payment-service\"}[5m])) by (uri, method)" }]
    },
    {
      "title": "Error rate (%)",
      "type": "timeseries",
      "targets": [{ "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"payment-service\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"payment-service\"}[5m]))" }]
    },
    {
      "title": "p50 / p95 / p99 latency",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[5m])) by (le))" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[5m])) by (le))" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"payment-service\"}[5m])) by (le))" }
      ]
    },
    {
      "title": "Authorization outcome (approved vs. declined)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"payment-service\",uri=\"/api/v1/payments/authorize\",status=\"200\"}[5m]))" }
      ]
    },
    {
      "title": "Rate limiter — calls permitted vs. rejected",
      "type": "timeseries",
      "targets": [{ "expr": "resilience4j_ratelimiter_calls{application=\"payment-service\"}" }]
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "targets": [{ "expr": "jvm_memory_used_bytes{application=\"payment-service\",area=\"heap\"}" }]
    },
    {
      "title": "HikariCP active connections",
      "type": "timeseries",
      "targets": [{ "expr": "hikaricp_connections_active{application=\"payment-service\"}" }]
    }
  ]
}
