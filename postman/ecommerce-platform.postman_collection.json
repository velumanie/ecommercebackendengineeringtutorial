            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SHOULD-FAIL\",\n  \"name\": \"Should be forbidden\",\n  \"price\": 1.00\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
