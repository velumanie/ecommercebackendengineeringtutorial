    {
      "name": "4. Negative / RBAC Cases",
      "description": "Confirms the security model actually enforces what docs/architecture.html Part 7 claims \u2014 run these with whichever token is currently in {{accessToken}} / {{customerAccessToken}}.",
      "item": [
        {
          "name": "Create product as CUSTOMER -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
