              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 999 } ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
