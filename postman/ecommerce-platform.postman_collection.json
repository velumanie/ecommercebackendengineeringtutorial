                ]
              }
            }
          ]
        },
        {
          "name": "Place order with no token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 1 } ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 (not authenticated at all \u2014 distinct from 403)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order for nonexistent product -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [ { \"productId\": \"00000000-0000-0000-0000-000000000000\", \"quantity\": 1 } ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 (inventory-service has no stock row for this id)', () => pm.response.to.have.status(409));",
                  "pm.test('Body is RFC 9457 problem+json', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('type');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password -> 401",
